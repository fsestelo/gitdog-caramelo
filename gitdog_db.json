  "workflows": [
    {
      "id": "wf-customers",
      "name": "Sync Stripe Customers to HubSpot",
      "description": "Sincroniza automaticamente contatos e transações financeiras em tempo real.",
      "active": true,
      "createdAt": "2026-03-01T10:00:00Z",
      "updatedAt": "2026-06-08T20:12:00Z"
    },
    {
      "id": "wf-alerts",
      "name": "Critical Error Alerts to Slack & PagerDuty",
      "description": "Monitorea webhooks de erros do sistema e dispara alertas sonoros e mensagens.",
      "active": true,
      "createdAt": "2026-03-15T11:00:00Z",
      "updatedAt": "2026-06-07T14:30:00Z"
    },
    {
      "id": "wf-payment",
      "name": "Boleto Payment Processor & PDF Invoice Generator",
      "description": "Gera boleto bancário em PDF, envia por email e atualiza status no banco PostgreSQL.",
      "active": false,
      "createdAt": "2026-04-10T16:00:00Z",
      "updatedAt": "2026-06-05T08:15:00Z"
    }
  ],
  "workflow_versions": [
    {
      "id": "ver-cust-v1",
      "workflowId": "wf-customers",
      "version": 1,
      "workflowData": {
        "nodes": [
          { "id": "n-stripe-hook", "name": "Stripe Webhook Listener", "type": "n8n-nodes-base.webhook", "position": [100, 200], "parameters": { "path": "/stripe-customer-created" } },
          { "id": "n-hubspot", "name": "Create Contact HubSpot", "type": "n8n-nodes-base.hubspot", "position": [350, 200], "parameters": { "operation": "create", "email": "={{ $json.body.email }}" } }
        ],
        "connections": {}
      },
      "comment": "Initial setup linking webhook directly to HubSpot contact creation",
      "authorId": "u3-dev",
      "authorName": "Thiago Silva (Developer)",
      "createdAt": "2026-03-01T10:00:00Z"
    },
    {
      "id": "ver-cust-v2",
      "workflowId": "wf-customers",
      "version": 2,
      "workflowData": {
        "nodes": [
          { "id": "n-stripe-hook", "name": "Stripe Webhook Listener", "type": "n8n-nodes-base.webhook", "position": [100, 200], "parameters": { "path": "/stripe-customer-created" } },
          { "id": "n-filter-real", "name": "Filter Demo Emails", "type": "n8n-nodes-base.if", "position": [250, 200], "parameters": { "conditions": { "string": [{ "value1": "={{ $json.body.email }}", "operation": "notContains", "value2": "@demo.com" }] } } },
          { "id": "n-hubspot", "name": "Create Contact HubSpot", "type": "n8n-nodes-base.hubspot", "position": [450, 200], "parameters": { "operation": "create", "email": "={{ $json.body.email }}", "properties": { "leadStatus": "New" } } }
        ],
        "connections": {}
      },
      "comment": "Added Filter Node to prevent demo emails from polluting CRM data",
      "authorId": "u3-dev",
      "authorName": "Thiago Silva (Developer)",
      "createdAt": "2026-06-08T20:12:00Z"
    },
    {
      "id": "ver-alerts-v1",
      "workflowId": "wf-alerts",
      "version": 1,
      "workflowData": {
        "nodes": [
          { "id": "n-webhook", "name": "Webhook Ingress", "type": "n8n-nodes-base.webhook", "position": [150, 300], "parameters": { "path": "/alerts-ingress" } },
          { "id": "n-slack", "name": "Slack Alert", "type": "n8n-nodes-base.slack", "position": [400, 300], "parameters": { "channel": "#ops-alerts", "text": "Error: ={{ $json.body.message }}" } }
        ],
        "connections": {}
      },
      "comment": "Baseline operational alerts to slack channel",
      "authorId": "u3-dev",
      "authorName": "Thiago Silva (Developer)",
      "createdAt": "2026-03-15T11:00:00Z"
    },
    {
      "id": "ver-alerts-v2",
      "workflowId": "wf-alerts",
      "version": 2,
      "workflowData": {
        "nodes": [
          { "id": "n-webhook", "name": "Webhook Ingress", "type": "n8n-nodes-base.webhook", "position": [150, 300], "parameters": { "path": "/alerts-ingress" } },
          { "id": "n-slack", "name": "Slack Alert", "type": "n8n-nodes-base.slack", "position": [400, 200], "parameters": { "channel": "#ops-alerts", "text": "Error Level: ={{ $json.body.level }} - Msg: ={{ $json.body.message }}" } },
          { "id": "n-pagerduty", "name": "PagerDuty Trigger Event", "type": "n8n-nodes-base.pagerDuty", "position": [400, 400], "parameters": { "routingKey": "pd-monitoring-key-xyz", "eventAction": "trigger" } }
        ],
        "connections": {}
      },
      "comment": "Configured PagerDuty secondary escalation trigger for high-priority outages",
      "authorId": "u2-manager",
      "authorName": "Jane Doe (Release Manager)",
      "createdAt": "2026-06-07T14:30:00Z"
    },
    {
      "id": "ver-pay-v1",
      "workflowId": "wf-payment",
      "version": 1,
      "workflowData": {
        "nodes": [
          { "id": "n-cron", "name": "Daily Boleto Sync", "type": "n8n-nodes-base.cron", "position": [100, 300], "parameters": { "triggerTimes": { "item": [{ "mode": "custom", "hour": "22" }] } } },
          { "id": "n-pdf", "name": "Generate Invoice PDF", "type": "n8n-nodes-base.htmlToPdf", "position": [350, 300], "parameters": { "html": "<h1>Invoice</h1>" } },
          { "id": "n-email", "name": "Send Invoice PDF", "type": "n8n-nodes-base.emailSend", "position": [600, 300], "parameters": { "toEmail": "customer@company.com" } }
        ],
        "connections": {}
      },
      "comment": "First draft of PDF invoice generator which runs at 10 PM daily",
      "authorId": "u3-dev",
      "authorName": "Thiago Silva (Developer)",
      "createdAt": "2026-04-10T16:00:00Z"
    }
